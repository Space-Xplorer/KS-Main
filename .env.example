# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- Supabase ---------------------------------------------------------------
# Project settings -> API. Safe to expose: the anon key is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Bypasses RLS completely. Server-only — never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Email (needed from the pre-registration milestone onward) ---------------
RESEND_API_KEY=""
EMAIL_FROM="passes@your-domain.example"

# Local Supabase (npm run db:start) prints its own URL and keys — use those
# for development instead of the cloud project.
