# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
# Full deployment checklist: docs/runbooks/deployment.md

# --- Supabase ---------------------------------------------------------------
# Project settings -> API. Safe to expose: the anon key is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Bypasses RLS completely. Server-only — never prefix this with NEXT_PUBLIC_,
# never put it in Vercel's client-exposed env, never run this repo's local
# scripts against production with a key you are not prepared to lose control of.
SUPABASE_SERVICE_ROLE_KEY=""

# Local Supabase (npm run db:start) prints its own URL and keys — use those
# for development instead of the cloud project. Don't point local dev at the
# real cloud project; keep them separate.

# --- Dev harness (src/app/dev/attendance) ------------------------------------
# Exercises the offline attendance pipeline (issue -> scan -> sync) before the
# real admin UI exists. Off everywhere by default. ALLOW_DEV_HARNESS gates the
# API routes server-side; NEXT_PUBLIC_ALLOW_DEV_HARNESS gates the page itself.
# Gated on an explicit flag rather than NODE_ENV because Vercel sets
# NODE_ENV=production on every deployment it builds, previews included — a
# NODE_ENV check would never fire there even when you want it to (e.g. to test
# camera scanning on a real phone against a preview URL).
# Leave both unset (or "false") in Vercel's Production environment. Only
# set them somewhere you have deliberately chosen to expose a test event's
# signing secret — e.g. a Preview environment, briefly, for a specific test.
ALLOW_DEV_HARNESS="false"
NEXT_PUBLIC_ALLOW_DEV_HARNESS="false"
DEV_HARNESS_KEY="dev-only-not-a-real-secret"
NEXT_PUBLIC_DEV_HARNESS_KEY="dev-only-not-a-real-secret"

# --- Email --------------------------------------------------------------------
# Not currently used by the deployed app. QR generation and email delivery run
# as a local script against Supabase directly (see docs/runbooks/deployment.md)
# rather than as a Vercel route, so Vercel does not need these. Fill in only
# if/when that changes.
# RESEND_API_KEY=""
# EMAIL_FROM="passes@your-domain.example"
